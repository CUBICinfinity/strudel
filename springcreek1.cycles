# new revision
samples('github:switchangel/pad')
setCps(135/240)


$: s("sbd!4")
  .distort("3:.3").coarse(64)
  .duck("2:3").duckattack(.2).duckdepth(.8)
  //._scope()


$: n(irand(10).sub(7).seg(16))
  .rib("<42 33>/6", 1).scale("<c#:minor f:locrian>/6")
  .s("sawtooth")
  .distort("2.2:.3")//.coarse(16)
  .lpf(slider(36.96,0,80).pow(2)).lpenv(slider(4.24, 0, 8)).lpq(12)//32
  .color("#a0f").pianoroll({cycles:3, playhead:0.2})
  .orbit(2).postgain(slider(0.136,0,0.5))
  .fm(2).fmh(2.04).room(1).roomsize(6)


_$: s("square").orbit(3).seg(16).decay(.1).fm(time).fmh(time).gain(1.5)


$: s("swpad:1").fit().note("c2, eb2")
  .splice(5, "1 [3!2] [1!2] [2 4/2]")
  .dec(slider(0.121,0,1))//.coarse("8").gain(1.5)


all(x => x.postgain(slider(0.106,0,1)))







