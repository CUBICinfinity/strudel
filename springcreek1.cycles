samples('github:switchangel/breaks')
samples('github:switchangel/pad')
samples('github:tidalcycles/uzu-drumkit')
samples('github:tidalcycles/dirt-samples')

setCps(130/60/4)

// Bring in first without distortion. when introduce large pianoroll, remove scope.
$: s("sbd!4")
  .distort("3:.3")
  .duck("2:3:4").duckattack(.2).duckdepth(.8)
  //._scope()

// Introduce second. Add rib complexity. Add key changes later.
$: n(irand(10).sub(7).seg(16).round())
  .rib("<42 33>/6", 1).scale("<c#:minor f:locrian>/6")
.distort("2.2:.3")
.s("sawtooth").lpf(slider(23.3,0,100).pow(2)).lpenv(slider(1.296, 0, 8)).lpq(12)
.orbit(2).pianoroll({cycles:3, playhead:0.2})
  .postgain(0.9)

// Bring in only before pulse riser and sbd distortion. Silence after.
_$: s("supersaw").detune(1).rel(5).beat(2, 32).slow(2)
  .fm(2).fmh(2.04).room(1).roomsize(6)
.orbit(3)

// Don't silence after creation. Only much later.
_$: s("pulse").orbit(4).seg(16).dec(.1).fm(time).fmh(time)


$: s("swpad:1").fit().splice(5, "1 [3!2] [1!2] [2 4/2]")
  .dec(slider(0.088,0,1)).coarse("8")
.note("c2, eb2")

all(x => x.postgain(0.1))



